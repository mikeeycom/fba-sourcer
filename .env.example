CLAUDE_API_KEY=your-claude-api-key-here
KEEPA_API_KEY=your-keepa-api-key-here

# SP-API - from Seller Central > Apps & Services > Develop Apps
# (Private app, Production type, "Pricing" role, self-authorized against
# your own seller account - NOT the Sandbox refresh token)
SP_API_CLIENT_ID=your-sp-api-client-id-here
SP_API_CLIENT_SECRET=your-sp-api-client-secret-here
SP_API_REFRESH_TOKEN=your-sp-api-refresh-token-here
